{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "exposeye: open the app",
      "type": "debugpy",
      "request": "launch",
      "module": "exposeye.app",
      "console": "integratedTerminal",
      "justMyCode": true
    },
    {
      "name": "exposeye: app in browser",
      "type": "debugpy",
      "request": "launch",
      "module": "exposeye.app",
      "args": ["--browser"],
      "console": "integratedTerminal"
    },
    {
      "name": "exposeye CLI: scan a domain",
      "type": "debugpy",
      "request": "launch",
      "module": "exposeye",
      "args": ["${input:domain}", "--open"],
      "console": "integratedTerminal",
      "justMyCode": true
    },
    {
      "name": "exposeye CLI: passive scan",
      "type": "debugpy",
      "request": "launch",
      "module": "exposeye",
      "args": ["${input:domain}", "--passive", "--open"],
      "console": "integratedTerminal"
    }
  ],
  "inputs": [
    {
      "id": "domain",
      "type": "promptString",
      "description": "Domain to scan",
      "default": "example.com"
    }
  ]
}
